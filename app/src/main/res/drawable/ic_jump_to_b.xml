<?xml version="1.0" encoding="utf-8"?>
<!-- Jump to Point B: arrow pointing RIGHT with the vertical bar on the LEFT
     = "skip forward and play at Point B". ic_jump_to_a is its exact mirror. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Vertical marker bar on the left -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M5,4 L7,4 L7,20 L5,20 Z" />

    <!-- Bold right-pointing arrow -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M10,5 L19,12 L10,19 Z" />
</vector>
