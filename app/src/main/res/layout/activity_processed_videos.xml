<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF17171C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageButton
                android:id="@+id/processedBackBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#FFFFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Processed Videos"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/processedSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Merged, Split &amp; Compressed"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Category labels row (scrollable so all four chips stay readable) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/processedMergedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_editor_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Merged: 0"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/processedSplitCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_editor_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Split: 0"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/processedCompressedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_editor_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Compressed: 0"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/processedOtherCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_editor_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Other: 0"
                    android:textColor="#88FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Video list -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/processedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/processedEmptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.4"
                    android:src="@drawable/ic_video_edit"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/processedEmptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:text="No processed videos yet"
                    android:textColor="#88FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
