<?xml version="1.0" encoding="utf-8"?>
<!-- In-app player for a processed audio file (mirrors activity_video_player.xml). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF17171C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="2dp">

            <ImageButton
                android:id="@+id/playerBackBtn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="song_merged.mp3" />
        </LinearLayout>

        <!-- Player body: controls while a file is loaded, message otherwise -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <LinearLayout
                android:id="@+id/playerControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:alpha="0.85"
                    android:contentDescription="Audio"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/accent_primary" />

                <SeekBar
                    android:id="@+id/playerSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/playerCurrentTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/playerTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#AAFFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/playerPlayBtn"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_editor_btn_primary"
                    android:contentDescription="Play/Pause"
                    android:padding="16dp"
                    android:src="@drawable/ic_play"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/playerErrorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="This file can no longer be found."
                tools:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
