<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_icon_container" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="20dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_ab_repeat"
            app:tint="@color/accent_primary"
            android:contentDescription="A-B Repeat" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="A-B Repeat"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="12dp" />

        <!-- Inline fine-tune step control: [-] [input] [+] (seconds),
             replaces the old tune-icon popup dialog -->
        <LinearLayout
            android:id="@+id/ab_step_container"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_container"
            android:paddingHorizontal="2dp">

            <ImageView
                android:id="@+id/ab_step_minus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Decrease step"
                android:src="@drawable/ic_nudge_minus"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/ab_step_input"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:hint="1"
                android:textColorHint="@color/text_tertiary"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:contentDescription="Fine-tune step in seconds" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="s"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary" />

            <ImageView
                android:id="@+id/ab_step_plus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Increase step"
                android:src="@drawable/ic_nudge_plus"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/ab_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_icon_container"
            android:text="OFF"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

    <!-- Playback position: current time above the slider, total time on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/ab_current_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent_primary" />

        <TextView
            android:id="@+id/ab_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/ab_progress_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingHorizontal="16dp"
        android:progressTint="@color/accent_primary"
        android:thumbTint="@color/accent_primary" />

    <!-- Position nudge: step the playback position by ±3s (default) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="2dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/ab_position_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Seek backward 3 seconds"
            android:src="@drawable/ic_nudge_minus"
            app:tint="@color/text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Tapping opens the keyboard to type a custom seek step (seconds).
             Compact: no stretch, tight "3s" grouping with the suffix. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/ab_position_step_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="18dp"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:text="3"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:contentDescription="Seek step in seconds" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="s"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/ab_position_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Seek forward 3 seconds"
            android:src="@drawable/ic_nudge_plus"
            app:tint="@color/text_secondary" />

        <!-- Small play/pause toggle -->
        <ImageView
            android:id="@+id/ab_play_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play or pause"
            android:src="@drawable/ic_play"
            app:tint="@color/success" />
    </LinearLayout>

    <!-- A-B range: slide the two handles to adjust Point A and Point B -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Point A"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Point B"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/ab_range_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        app:trackColorActive="@color/accent_primary"
        app:trackColorInactive="@color/text_tertiary"
        app:thumbColor="@color/accent_primary" />

    <TextView
        android:id="@+id/ab_range_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="Slide the handles to set Point A and Point B"
        android:textSize="11sp"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <!-- Point A -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Point A"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/ab_point_a_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:gravity="end"
            android:text="--:--"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Edit Point A time"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/ab_nudge_a_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Point A minus 1 second"
            android:src="@drawable/ic_nudge_minus"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/ab_nudge_a_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Point A plus 1 second"
            android:src="@drawable/ic_nudge_plus"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/ab_play_a"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play from Point A"
            android:src="@drawable/ic_jump_to_a"
            app:tint="@color/accent_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ab_set_a_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Set A" />
    </LinearLayout>

    <!-- Point B -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Point B"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/ab_point_b_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:gravity="end"
            android:text="--:--"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Edit Point B time"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/ab_nudge_b_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Point B minus 1 second"
            android:src="@drawable/ic_nudge_minus"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/ab_nudge_b_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Point B plus 1 second"
            android:src="@drawable/ic_nudge_plus"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/ab_play_b"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play from Point B"
            android:src="@drawable/ic_jump_to_b"
            app:tint="@color/accent_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ab_set_b_btn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Set B" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ab_clear_btn"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear"
            android:textColor="@color/error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ab_toggle_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
