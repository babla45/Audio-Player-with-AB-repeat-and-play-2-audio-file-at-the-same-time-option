<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/voice_slider_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_slider_value"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/gradient_accent"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_on_accent"
            android:textSize="12sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/voice_slider_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:progressTint="@color/accent_primary"
        android:thumbTint="@color/accent_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/voice_slider_min"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/voice_slider_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
