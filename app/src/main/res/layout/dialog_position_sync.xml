<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- Primary Track -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/primary_track"
        android:textStyle="bold"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:textColor="@color/accent_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/primaryTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/primaryPositionSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:progressTint="@color/accent_primary"
        android:progressBackgroundTint="@color/surface_600"
        android:thumbTint="@color/accent_primary" />

    <TextView
        android:id="@+id/primaryPositionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00 / 0:00"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp" />

    <!-- Secondary Track -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/secondary_track"
        android:textStyle="bold"
        android:textSize="12sp"
        android:letterSpacing="0.08"
        android:textColor="@color/accent_secondary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/secondaryTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/secondaryPositionSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:progressTint="@color/accent_secondary"
        android:progressBackgroundTint="@color/surface_600"
        android:thumbTint="@color/accent_secondary" />

    <TextView
        android:id="@+id/secondaryPositionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0:00 / 0:00"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
