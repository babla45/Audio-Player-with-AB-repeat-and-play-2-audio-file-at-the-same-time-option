<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_icon_container" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_speed"
            android:contentDescription="Boost"
            android:tint="@color/accent_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Boost"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/boost_current_value"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:background="@drawable/gradient_accent"
            android:text="1.00x"
            android:textSize="13sp"
            android:textColor="@color/text_on_accent" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/boost_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:min="100"
        android:max="500"
        android:progress="100"
        android:progressTint="@color/accent_primary"
        android:thumbTint="@color/accent_primary" />

    <!-- Quick preset chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_150"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.0x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_250"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.5x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_300"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.0x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_350"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.5x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_400"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.0x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_450"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.5x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/boost_chip_500"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.0x"
                android:layout_marginEnd="8dp"
                android:checkable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1.00x"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.00x"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary" />
    </LinearLayout>

</LinearLayout>